# Generated files are compared byte-for-byte by tests (`OPROBE_BLESS=1`): keep LF on every OS.
docs/** text eol=lf
schemas/** text eol=lf
llms.txt text eol=lf
llms-full.txt text eol=lf
README*.md text eol=lf
CHANGELOG.md text eol=lf
crates/oprobe-core/tests/codegen/** text eol=lf
# Images are binary: never convert line endings in them.
*.png binary
*.ico binary
# Run-file fixtures are compared and decoded as bytes.
*.oprobe binary
