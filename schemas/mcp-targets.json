{
  "$defs": {
    "Budgets": {
      "description": "Limits for one command.",
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_cost_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TargetOut": {
      "properties": {
        "allowed": {
          "description": "Tools may use it on this server (`--allow-target`).",
          "type": "boolean"
        },
        "credentials": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Options with secrets redacted.",
          "type": "object"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "options",
        "allowed"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/mcp-targets.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP list_targets: configured targets and the server's rails",
  "properties": {
    "allow_targets": {
      "description": "The server's `--allow-target` list (empty: every target).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "allow_write": {
      "description": "The server accepts runs that write test data.",
      "type": "boolean"
    },
    "default_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "server_budgets": {
      "$ref": "#/$defs/Budgets",
      "description": "Budgets every run gets."
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetOut"
      },
      "type": "array"
    }
  },
  "required": [
    "targets",
    "allow_targets",
    "allow_write",
    "server_budgets"
  ],
  "title": "oprobe mcp-targets",
  "type": "object",
  "x-rust-type": "TargetsOut"
}
