{
  "$defs": {
    "Budgets": {
      "description": "Limits for one command.",
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_cost_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ErrorBody": {
      "description": "Machine form of an error (`{\"type\":\"error\",\"error\":{…}}` in json/ndjson output).",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "docs": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable error code. Serialized as its dotted string (e.g. `net.timeout`).",
      "enum": [
        "usage.invalid_argument",
        "usage.unknown_target",
        "usage.unknown_run",
        "usage.unknown_baseline",
        "config.invalid",
        "config.unknown_option",
        "auth.no_credentials",
        "auth.denied",
        "net.unreachable",
        "net.dns",
        "net.tls",
        "net.timeout",
        "net.rate_limited",
        "net.http",
        "storage.not_found",
        "storage.throttled",
        "storage.unsupported",
        "safety.budget_exceeded",
        "safety.read_only",
        "safety.refused",
        "run.sla_failed",
        "run.regression",
        "run.interrupted",
        "internal"
      ],
      "type": "string"
    },
    "Plan": {
      "description": "What a run would do (`--dry-run`).",
      "properties": {
        "assumptions": {
          "description": "How the estimates were made.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "command": {
          "default": "",
          "description": "The command that runs this plan (`oprobe run …`, every non-default setting).",
          "type": "string"
        },
        "concurrency_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "duration_s": {
          "format": "double",
          "type": "number"
        },
        "estimated_bytes": {
          "description": "Estimated bytes transferred (up + down).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "estimated_cost_usd": {
          "description": "Request cost at list prices, where a price table applies.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "estimated_ops_count": {
          "description": "Estimated logical operations (warmup + window).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "estimated_requests_count": {
          "description": "Estimated backend requests (dataset upload + workload + cleanup).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eta_s": {
          "description": "Estimated wall time, dataset upload and cleanup included.",
          "format": "double",
          "type": "number"
        },
        "objects_deleted_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_written_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "preset": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "run_prefix": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_ref": {
          "default": "",
          "description": "The target as given (URL or `lab://` scenario), for the run command.",
          "type": "string"
        },
        "warmup_s": {
          "format": "double",
          "type": "number"
        },
        "warnings": {
          "default": [],
          "description": "Things that would run, but probably not as meant (e.g. warmup ≥ window).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "target",
        "preset",
        "run_prefix",
        "read_only",
        "concurrency_count",
        "warmup_s",
        "duration_s",
        "estimated_ops_count",
        "estimated_requests_count",
        "estimated_bytes",
        "objects_written_count",
        "objects_deleted_count",
        "eta_s",
        "budgets",
        "assumptions",
        "target_ref",
        "command",
        "warnings"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/mcp-plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP plan_run: the dry-run plan, budgets and whether the server accepts it",
  "properties": {
    "allowed": {
      "description": "`start_run` would accept it on this server.",
      "type": "boolean"
    },
    "budget_warnings": {
      "description": "Plan estimates already above a budget (the run would stop early).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets",
      "description": "Budgets the run would get (server and request, the stricter of each)."
    },
    "plan": {
      "$ref": "#/$defs/Plan"
    },
    "refusals": {
      "description": "Why not, when not allowed.",
      "items": {
        "$ref": "#/$defs/ErrorBody"
      },
      "type": "array"
    },
    "writes": {
      "description": "The run writes test data.",
      "type": "boolean"
    }
  },
  "required": [
    "plan",
    "budgets",
    "writes",
    "allowed",
    "refusals",
    "budget_warnings"
  ],
  "title": "oprobe mcp-plan",
  "type": "object",
  "x-rust-type": "PlanOut"
}
