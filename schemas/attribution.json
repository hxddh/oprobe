{
  "$defs": {
    "Factor": {
      "description": "One attribute value and how much more common it is among the selected requests.",
      "properties": {
        "attribute": {
          "description": "Attribute name: `api`, `status`, `protocol`, `connection`, `remote`, `attempt`,\n`error`, `stage` (the dominant stage of the request).",
          "type": "string"
        },
        "lift": {
          "description": "`selected_ratio / rest_ratio` (capped; large when the value is absent from the rest).",
          "format": "double",
          "type": "number"
        },
        "rest_ratio": {
          "description": "Share of the other requests with this value (0–1).",
          "format": "double",
          "type": "number"
        },
        "selected_count": {
          "description": "Selected requests with this value.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected_ratio": {
          "description": "Share of selected requests with this value (0–1).",
          "format": "double",
          "type": "number"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "value",
        "selected_ratio",
        "rest_ratio",
        "lift",
        "selected_count"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/3/attribution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Outlier attribution (MCP analyze_run, explain)",
  "properties": {
    "factors": {
      "description": "Most distinctive first.",
      "items": {
        "$ref": "#/$defs/Factor"
      },
      "type": "array"
    },
    "rest_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "selected_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "selected_count",
    "rest_count",
    "factors"
  ],
  "title": "oprobe attribution",
  "type": "object",
  "x-rust-type": "Attribution"
}
