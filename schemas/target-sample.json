{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "PrefixStat": {
      "description": "Objects and bytes under one first-level prefix.",
      "properties": {
        "median_bytes": {
          "description": "Median object size under the prefix.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "prefix": {
          "description": "The prefix, relative to the target root, ending in `/` (`\"\"`: objects at the root).",
          "type": "string"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "prefix",
        "objects_count",
        "total_bytes",
        "median_bytes"
      ],
      "type": "object"
    },
    "SampleEntry": {
      "description": "An example object.",
      "properties": {
        "key": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "size_bytes"
      ],
      "type": "object"
    },
    "SizeBucket": {
      "description": "One size class of the distribution.",
      "properties": {
        "max_bytes": {
          "description": "Upper bound of the class (objects of at most this size; the last class is open).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "objects_count"
      ],
      "type": "object"
    },
    "SizeDistribution": {
      "description": "Object sizes of the sample.",
      "properties": {
        "buckets": {
          "items": {
            "$ref": "#/$defs/SizeBucket"
          },
          "type": "array"
        },
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mean_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "min_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p50_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p90_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "min_bytes",
        "p50_bytes",
        "p90_bytes",
        "max_bytes",
        "mean_bytes",
        "buckets"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/target-sample.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe target sample` (MCP sample_objects): prefixes, counts and sizes",
  "properties": {
    "examples": {
      "description": "A few keys (relative to the target root).",
      "items": {
        "$ref": "#/$defs/SampleEntry"
      },
      "type": "array"
    },
    "limit_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "objects_count": {
      "description": "Objects examined (at most `limit_count`).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "prefix": {
      "description": "The listed prefix, relative to the target root (`\"\"`: the root).",
      "type": "string"
    },
    "prefixes": {
      "description": "First-level prefixes under `prefix`, most objects first.",
      "items": {
        "$ref": "#/$defs/PrefixStat"
      },
      "type": "array"
    },
    "sizes": {
      "$ref": "#/$defs/SizeDistribution"
    },
    "suggested_existing": {
      "description": "The prefix to measure with `--existing` (the one holding the most objects), if any.",
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "description": "The target as given.",
      "type": "string"
    },
    "total_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "description": "The listing stopped at the limit: counts are a sample, not the whole target.",
      "type": "boolean"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "target",
    "prefix",
    "objects_count",
    "total_bytes",
    "truncated",
    "limit_count",
    "prefixes",
    "sizes",
    "examples",
    "next",
    "warnings"
  ],
  "title": "oprobe target-sample",
  "type": "object",
  "x-rust-type": "ObjectSample"
}
