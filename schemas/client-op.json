{
  "$defs": {
    "OpName": {
      "description": "The operations of the protocol.",
      "oneOf": [
        {
          "const": "get",
          "description": "GET an object or a byte range of it.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "PUT an object (`data_b64`, `size` bytes).",
          "type": "string"
        },
        {
          "const": "head",
          "description": "HEAD an object.",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "Delete `keys` (one request per key, or a batch delete when the adapter can).",
          "type": "string"
        },
        {
          "const": "list",
          "description": "List under `prefix` (all pages; `recursive`: no delimiter; `limit`: page size).",
          "type": "string"
        },
        {
          "const": "copy",
          "description": "Server-side copy `source` → `key`.",
          "type": "string"
        }
      ]
    },
    "WireRange": {
      "description": "A byte range of a `get`.",
      "properties": {
        "length_bytes": {
          "description": "Bytes from the offset (absent: to the end).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset_bytes": {
          "description": "First byte (absent with `suffix_bytes`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "suffix_bytes": {
          "description": "The last N bytes (`Range: bytes=-N`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/client-op.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "oprobe client protocol: one operation oprobe asks the adapter to run",
  "properties": {
    "content_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_b64": {
      "description": "`put`: the payload, base64 (standard alphabet, padded).",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "if_match": {
      "type": [
        "string",
        "null"
      ]
    },
    "if_none_match": {
      "description": "`*`: create only.",
      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "keys": {
      "description": "`delete`: the keys to delete.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "description": "`list`: page size.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "User metadata (`x-amz-meta-*`).",
      "type": "object"
    },
    "op": {
      "$ref": "#/$defs/OpName"
    },
    "prefix": {
      "description": "`list`: the prefix.",
      "type": [
        "string",
        "null"
      ]
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "`get`: the byte range (absent: the whole object)."
    },
    "recursive": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "size_bytes": {
      "description": "`put`: payload size.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "source": {
      "description": "`copy`: the source key.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "op"
  ],
  "title": "oprobe client-op",
  "type": "object",
  "x-rust-type": "WireOp"
}
