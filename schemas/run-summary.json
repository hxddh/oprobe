{
  "$defs": {
    "VerdictLevel": {
      "description": "Overall judgement.",
      "oneOf": [
        {
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "const": "review",
          "description": "Worth a look (informational findings, warnings, partial run).",
          "type": "string"
        },
        {
          "const": "attention",
          "description": "Warning findings.",
          "type": "string"
        },
        {
          "const": "critical",
          "description": "Critical findings or a breached SLA.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/run-summary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sidecar summary of a stored run (runs/<id>.json)",
  "properties": {
    "cost_per_month_usd": {
      "description": "Projected monthly cost, where cost applies.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "error_ratio": {
      "format": "double",
      "type": "number"
    },
    "headline": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "interrupted": {
      "type": "boolean"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "ops_per_s": {
      "format": "double",
      "type": "number"
    },
    "p50_ms": {
      "format": "double",
      "type": "number"
    },
    "p99_ms": {
      "format": "double",
      "type": "number"
    },
    "partial": {
      "description": "Why the run is partial: `budget` (a safety budget stopped it) or `interrupted`\n(stopped early); absent for a complete run.",
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "description": "The run file (filled in when listing; not stored).",
      "type": [
        "string",
        "null"
      ]
    },
    "preset": {
      "description": "The workload preset (absent in summaries written before 5.0).",
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "target_display": {
      "type": "string"
    },
    "target_id": {
      "description": "The target identity of the run's spec (`store::TargetId`, empty when it does not\nresolve). Required, so sidecars written without it are rebuilt from the run file.",
      "type": "string"
    },
    "target_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "throttled_request_ratio": {
      "description": "Throttled responses / requests (absent in summaries written before 5.0).",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "verdict_level": {
      "$ref": "#/$defs/VerdictLevel"
    },
    "window_s": {
      "format": "double",
      "type": "number"
    },
    "workload_hash": {
      "description": "`report.spec.workload_hash()`: runs with the same target and workload hash compare.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "target_display",
    "started_at",
    "window_s",
    "interrupted",
    "verdict_level",
    "headline",
    "ops_per_s",
    "p50_ms",
    "p99_ms",
    "error_ratio",
    "target_id",
    "workload_hash"
  ],
  "title": "oprobe run-summary",
  "type": "object",
  "x-rust-type": "RunSummary"
}
