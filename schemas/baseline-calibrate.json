{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/baseline-calibrate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe baseline calibrate`: the target's noise floor",
  "properties": {
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "noise_floor_ratio": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "The noise floor per metric (`p50_ms`, `p99_ms`, `ops_per_s`, `mib_per_s`): relative\nchanges below it are not significant.",
      "type": "object"
    },
    "pairs_count": {
      "description": "A/A pairs added.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "description": "Where it is stored.",
      "type": "string"
    },
    "run_ids": {
      "description": "The identical runs measured.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target": {
      "description": "Target identity the floor is stored under.",
      "type": "string"
    },
    "total_pairs_count": {
      "description": "A/A pairs known for this target and workload (all calibrations and verifications).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workload_hash": {
      "type": "string"
    }
  },
  "required": [
    "target",
    "workload_hash",
    "run_ids",
    "pairs_count",
    "total_pairs_count",
    "noise_floor_ratio",
    "path",
    "next",
    "warnings"
  ],
  "title": "oprobe baseline-calibrate",
  "type": "object",
  "x-rust-type": "CalibrateOutput"
}
