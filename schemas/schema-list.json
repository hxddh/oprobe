{
  "$defs": {
    "Direction": {
      "description": "Whether a schema describes something oprobe writes (outputs) or reads (inputs).",
      "oneOf": [
        {
          "const": "output",
          "description": "oprobe writes it (command results, reports, events, run files).",
          "type": "string"
        },
        {
          "const": "input",
          "description": "oprobe reads it (the config file, MCP tool inputs).",
          "type": "string"
        }
      ]
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "SchemaInfo": {
      "description": "One entry of `oprobe schema` without a name.",
      "properties": {
        "$id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "$id",
        "direction",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/schema-list.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe schema` without a name",
  "properties": {
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "schemas": {
      "items": {
        "$ref": "#/$defs/SchemaInfo"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schemas",
    "next",
    "warnings"
  ],
  "title": "oprobe schema-list",
  "type": "object",
  "x-rust-type": "SchemaList"
}
