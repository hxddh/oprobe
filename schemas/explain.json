{
  "$defs": {
    "Attribution": {
      "properties": {
        "factors": {
          "description": "Most distinctive first.",
          "items": {
            "$ref": "#/$defs/Factor"
          },
          "type": "array"
        },
        "rest_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "selected_count",
        "rest_count",
        "factors"
      ],
      "type": "object"
    },
    "Bottleneck": {
      "description": "The layer that dominates operation latency.",
      "oneOf": [
        {
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "const": "client_queue",
          "description": "Waiting for in-flight request permits / pooled connections.",
          "type": "string"
        },
        {
          "const": "client",
          "description": "Client-side processing (CPU, OpenDAL, response consumption).",
          "type": "string"
        },
        {
          "const": "connect",
          "description": "DNS / TCP / TLS / proxy handshakes.",
          "type": "string"
        },
        {
          "const": "upload",
          "description": "Uploading request bodies.",
          "type": "string"
        },
        {
          "const": "server_latency",
          "description": "Server time to first byte.",
          "type": "string"
        },
        {
          "const": "download",
          "description": "Downloading response bodies.",
          "type": "string"
        },
        {
          "const": "throttling",
          "description": "Rate limiting (429/503).",
          "type": "string"
        },
        {
          "const": "retry_backoff",
          "description": "Sleeping between retry attempts (errors that are not throttling).",
          "type": "string"
        },
        {
          "const": "local_backend",
          "description": "In-process backend (memory/fs) service time.",
          "type": "string"
        }
      ]
    },
    "Direction": {
      "description": "Which way a metric should move.",
      "oneOf": [
        {
          "const": "increase",
          "description": "Higher than the baseline.",
          "type": "string"
        },
        {
          "const": "decrease",
          "description": "Lower than the baseline.",
          "type": "string"
        },
        {
          "const": "at_most",
          "description": "At most the predicted value (e.g. a throttle budget).",
          "type": "string"
        },
        {
          "const": "at_least",
          "description": "At least the predicted value.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "Within the interval of the baseline (a change that must not cost anything).",
          "type": "string"
        }
      ]
    },
    "ErrorCode": {
      "description": "Stable error code. Serialized as its dotted string (e.g. `net.timeout`).",
      "enum": [
        "usage.invalid_argument",
        "usage.unknown_target",
        "usage.unknown_run",
        "usage.unknown_baseline",
        "config.invalid",
        "config.unknown_option",
        "auth.no_credentials",
        "auth.denied",
        "net.unreachable",
        "net.dns",
        "net.tls",
        "net.timeout",
        "net.rate_limited",
        "net.http",
        "storage.not_found",
        "storage.throttled",
        "storage.unsupported",
        "safety.budget_exceeded",
        "safety.read_only",
        "safety.refused",
        "run.sla_failed",
        "run.regression",
        "run.interrupted",
        "internal"
      ],
      "type": "string"
    },
    "Evidence": {
      "description": "The numbers and trace references behind a finding.",
      "properties": {
        "op_ids": {
          "description": "Operations that show the problem.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "text": {
          "description": "The evidence in words, with numbers.",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Named measurements (unit-suffixed keys).",
          "type": "object"
        },
        "windows": {
          "description": "Time windows (seconds from the window start) where it shows.",
          "items": {
            "$ref": "#/$defs/TimeWindow"
          },
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Expectation": {
      "description": "What a change should do to one metric: a predicted value with an interval.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "hi": {
          "description": "Upper end of the prediction interval, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "lo": {
          "description": "Lower end of the prediction interval, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "metric": {
          "description": "A report metric path, e.g. `summary.ops_per_s`, `throttled_request_ratio`, `p99_ms`.",
          "type": "string"
        },
        "predicted": {
          "description": "Predicted value, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "unit": {
          "description": "Unit of `predicted`, `lo` and `hi` (`ops_per_s`, `ms`, `ratio`, …).",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "direction",
        "predicted",
        "lo",
        "hi",
        "unit"
      ],
      "type": "object"
    },
    "ExplainRun": {
      "description": "Narrated explanation of a stored run.",
      "properties": {
        "bottleneck": {
          "$ref": "#/$defs/Bottleneck"
        },
        "exit_code": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "findings": {
          "description": "All findings, most severe first.",
          "items": {
            "$ref": "#/$defs/ExplainedFinding"
          },
          "type": "array"
        },
        "headline": {
          "type": "string"
        },
        "interrupted": {
          "type": "boolean"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "$ref": "#/$defs/VerdictLevel"
        },
        "narrative": {
          "description": "The explanation in sentences.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "slowest": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlowestAnalysis"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when the run file holds no request rows (e.g. tune runs)."
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "target",
        "level",
        "headline",
        "exit_code",
        "bottleneck",
        "interrupted",
        "findings",
        "narrative"
      ],
      "type": "object"
    },
    "ExplainedFinding": {
      "description": "A finding of the run with its documentation.",
      "properties": {
        "advice": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "doc": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingDoc"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog entry of the code (absent for codes this oprobe does not document)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "cause",
        "evidence",
        "advice"
      ],
      "type": "object"
    },
    "Factor": {
      "description": "One attribute value and how much more common it is among the selected requests.",
      "properties": {
        "attribute": {
          "description": "Attribute name: `api`, `status`, `protocol`, `connection`, `remote`, `attempt`,\n`error`, `stage` (the dominant stage of the request), `size` (bytes moved, binned),\n`rtt` (TCP RTT, binned), `time` (tenth of the run), `conn` (connection id).",
          "type": "string"
        },
        "lift_ratio": {
          "description": "`selected_ratio / rest_ratio`, smoothed (add-one) and capped.",
          "format": "double",
          "type": "number"
        },
        "rest_ratio": {
          "description": "Share of the other requests with this value (0–1).",
          "format": "double",
          "type": "number"
        },
        "selected_count": {
          "description": "Selected requests with this value.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected_ratio": {
          "description": "Share of selected requests with this value (0–1).",
          "format": "double",
          "type": "number"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "value",
        "selected_ratio",
        "rest_ratio",
        "lift_ratio",
        "selected_count"
      ],
      "type": "object"
    },
    "FindingDoc": {
      "description": "Documentation of one finding code.",
      "properties": {
        "category": {
          "description": "Area: `correctness`, `availability`, `bottleneck`, `network`, `efficiency`, `cost`,\n`sla`, `client`.",
          "type": "string"
        },
        "causes": {
          "description": "Typical causes, most common first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "code": {
          "description": "Stable code as it appears in `report.findings[].code`.",
          "type": "string"
        },
        "docs": {
          "description": "Documentation link.",
          "type": "string"
        },
        "knobs": {
          "description": "Related knobs, flags and profile settings.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "meaning": {
          "description": "What the finding means.",
          "type": "string"
        },
        "title": {
          "description": "Short title.",
          "type": "string"
        },
        "typical_severity": {
          "$ref": "#/$defs/Severity",
          "description": "Severity the diagnosis usually assigns (`critical` codes can also be `warning`)."
        },
        "verify": {
          "description": "How to confirm it (report fields, commands).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "title",
        "typical_severity",
        "category",
        "meaning",
        "causes",
        "verify",
        "knobs",
        "docs"
      ],
      "type": "object"
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "Overrides": {
      "description": "A change to a run: `--set key=value` pairs grouped by the part of the profile they change\n(canonical key names, see [`SET_KEYS`]). Built with [`Overrides::set`], which validates.",
      "properties": {
        "cost": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "knobs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "sla": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "target": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "workload": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Selection": {
      "description": "Which requests are \"selected\" (everything else is the comparison set).",
      "properties": {
        "api": {
          "description": "Restrict to one storage API (e.g. `GetObject`); applies to both sides.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_us": {
          "description": "Window start, µs from the measurement window start (inclusive).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "min_total_us": {
          "description": "Requests at least this slow (total), µs.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "to_us": {
          "description": "Window end, µs (exclusive).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "type": "string"
    },
    "SlowOp": {
      "description": "One of the slowest operations.",
      "properties": {
        "attempts_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dominant_stage": {
          "description": "Stage that dominated its slowest request (`queue`, `connect`, `send`, `ttfb`,\n`transfer`, `stall`).",
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "type": "string"
        },
        "latency_ms": {
          "format": "double",
          "type": "number"
        },
        "op_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verb": {
          "type": "string"
        }
      },
      "required": [
        "op_id",
        "verb",
        "key",
        "latency_ms",
        "attempts_count",
        "requests_count"
      ],
      "type": "object"
    },
    "SlowestAnalysis": {
      "description": "Outlier attribution of the slowest requests.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/SlowOp"
          },
          "type": "array"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "slowest_pct": {
          "description": "Percent of requests selected (by total time).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "slowest_pct",
        "selection",
        "attribution",
        "ops"
      ],
      "type": "object"
    },
    "TimeWindow": {
      "properties": {
        "from_s": {
          "format": "double",
          "type": "number"
        },
        "to_s": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "from_s",
        "to_s"
      ],
      "type": "object"
    },
    "VerdictLevel": {
      "description": "Overall judgement.",
      "oneOf": [
        {
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "const": "review",
          "description": "Worth a look (informational findings, warnings, partial run).",
          "type": "string"
        },
        {
          "const": "attention",
          "description": "Warning findings.",
          "type": "string"
        },
        {
          "const": "critical",
          "description": "Critical findings or a breached SLA.",
          "type": "string"
        }
      ]
    },
    "Verification": {
      "description": "How to test a finding's advice (design v4 §5).",
      "properties": {
        "command": {
          "description": "`oprobe verify RUN CODE`: replays the run with and without the change and judges it.",
          "type": "string"
        },
        "description": {
          "description": "The hypothesis in words.",
          "type": "string"
        },
        "expect": {
          "description": "What the change should do (filled by the findings that can predict it).",
          "items": {
            "$ref": "#/$defs/Expectation"
          },
          "type": "array"
        },
        "overrides": {
          "$ref": "#/$defs/Overrides",
          "description": "The change to the run's spec."
        },
        "replay": {
          "description": "The changed run as a self-contained `oprobe run TARGET …` command (no stored run\nneeded).",
          "type": "string"
        },
        "rerun": {
          "description": "`oprobe run --from RUN --set …`: the changed run alone.",
          "type": "string"
        }
      },
      "required": [
        "description",
        "overrides",
        "command",
        "rerun",
        "replay"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/explain.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe explain` (a run or a finding code)",
  "oneOf": [
    {
      "$ref": "#/$defs/FindingDoc",
      "description": "Documentation of one finding code.",
      "properties": {
        "kind": {
          "const": "finding_code",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "description": "Every finding code (`--list`).",
      "properties": {
        "codes": {
          "items": {
            "$ref": "#/$defs/FindingDoc"
          },
          "type": "array"
        },
        "kind": {
          "const": "finding_codes",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "codes"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/ExplainRun",
      "description": "A narrated run.",
      "properties": {
        "kind": {
          "const": "run",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "next",
    "warnings"
  ],
  "title": "oprobe explain",
  "type": "object",
  "x-rust-type": "ExplainOutput"
}
