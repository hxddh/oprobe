{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "TargetOut": {
      "properties": {
        "allowed": {
          "description": "Tools may use it on this server (`--allow-target`).",
          "type": "boolean"
        },
        "credentials": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Options with secrets redacted.",
          "type": "object"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "options",
        "allowed"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/mcp-save-target.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP save_target: the target saved",
  "properties": {
    "config_file": {
      "type": "string"
    },
    "next": {
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/TargetOut"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "target",
    "config_file",
    "warnings",
    "next"
  ],
  "title": "oprobe mcp-save-target",
  "type": "object",
  "x-rust-type": "SaveTargetOut"
}
