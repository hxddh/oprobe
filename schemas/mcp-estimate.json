{
  "$id": "https://github.com/hxddh/oprobe/schemas/5/mcp-estimate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP estimate_cost: request cost at list prices",
  "properties": {
    "applicable": {
      "description": "A price table applies (cloud provider detected or `provider` given).",
      "type": "boolean"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "estimated_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "estimated_cost_usd": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "estimated_requests_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "eta_s": {
      "format": "double",
      "type": "number"
    },
    "max_cost_usd": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "per_request_usd": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "within_budget": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "applicable",
    "estimated_requests_count",
    "estimated_bytes",
    "eta_s",
    "assumptions"
  ],
  "title": "oprobe mcp-estimate",
  "type": "object",
  "x-rust-type": "EstimateOut"
}
