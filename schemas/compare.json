{
  "$defs": {
    "ChangeKind": {
      "description": "What part of the setup a [`ConfigChange`] is in.",
      "oneOf": [
        {
          "const": "workload",
          "description": "What was run (preset, mix, dataset, access pattern, rate…): results are not comparable.",
          "type": "string"
        },
        {
          "const": "target",
          "description": "Where it ran (scheme, bucket/prefix, endpoint, backend options).",
          "type": "string"
        },
        {
          "const": "knobs",
          "description": "Client configuration: the legitimate subject of an A/B comparison.",
          "type": "string"
        },
        {
          "const": "host",
          "description": "The machine, network path or oprobe version that measured.",
          "type": "string"
        }
      ]
    },
    "Check": {
      "properties": {
        "baseline": {
          "format": "double",
          "type": "number"
        },
        "candidate": {
          "format": "double",
          "type": "number"
        },
        "change_pct": {
          "description": "Relative change in percent (positive = higher).",
          "format": "double",
          "type": "number"
        },
        "limit": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "name",
        "baseline",
        "candidate",
        "change_pct",
        "limit",
        "status"
      ],
      "type": "object"
    },
    "ConfigChange": {
      "description": "One setting that differs between baseline and candidate.",
      "properties": {
        "baseline": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "field": {
          "description": "Dotted path, e.g. `knobs.concurrency`, `workload.mix`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        }
      },
      "required": [
        "kind",
        "field",
        "baseline",
        "candidate"
      ],
      "type": "object"
    },
    "Status": {
      "enum": [
        "pass",
        "improved",
        "fail",
        "skipped"
      ],
      "type": "string"
    },
    "Thresholds": {
      "description": "Regression limits. Percentages are relative changes in the \"bad\" direction.",
      "properties": {
        "allow_target_change": {
          "default": false,
          "description": "Compare runs against different targets without failing (otherwise a gate failure).",
          "type": "boolean"
        },
        "allow_workload_change": {
          "default": false,
          "description": "Compare runs of different workloads without failing (otherwise a gate failure).",
          "type": "boolean"
        },
        "cost_pct": {
          "format": "double",
          "type": "number"
        },
        "error_rate_pp": {
          "description": "Max increase of the failed-operation rate in percentage points.",
          "format": "double",
          "type": "number"
        },
        "fail_on_new_throttling": {
          "description": "Gate throttling: fail when the candidate is throttled and the baseline was not, or when\nits throttle rate (throttled responses per request) grew by more than\n[`THROTTLE_RATE_PCT`] and [`THROTTLE_RATE_FLOOR`].",
          "type": "boolean"
        },
        "min_latency_delta_ms": {
          "description": "Latency changes smaller than this (ms) are never regressions (noise floor).",
          "format": "double",
          "type": "number"
        },
        "min_samples": {
          "description": "Skip latency checks for operations with fewer samples.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p50_pct": {
          "format": "double",
          "type": "number"
        },
        "p99_pct": {
          "format": "double",
          "type": "number"
        },
        "read_amp_pct": {
          "format": "double",
          "type": "number"
        },
        "request_amp_pct": {
          "format": "double",
          "type": "number"
        },
        "throughput_drop_pct": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "p99_pct",
        "p50_pct",
        "min_latency_delta_ms",
        "throughput_drop_pct",
        "error_rate_pp",
        "request_amp_pct",
        "read_amp_pct",
        "cost_pct",
        "fail_on_new_throttling",
        "min_samples",
        "allow_workload_change",
        "allow_target_change"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/3/compare.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe compare`",
  "properties": {
    "baseline": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    },
    "config_changes": {
      "description": "Every workload / target / knob / host setting that differs between the two runs.",
      "items": {
        "$ref": "#/$defs/ConfigChange"
      },
      "type": "array"
    },
    "passed": {
      "type": "boolean"
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "passed",
    "baseline",
    "candidate",
    "thresholds",
    "config_changes",
    "checks",
    "warnings"
  ],
  "title": "oprobe compare",
  "type": "object",
  "x-rust-type": "DiffReport"
}
