{
  "$id": "https://github.com/hxddh/oprobe/schemas/5/target-id.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The normalised identity of a storage target",
  "properties": {
    "authority": {
      "description": "`bucket`, `bucket@host[:port]`, `host[:port]` or empty (`fs`, `memory`).",
      "type": "string"
    },
    "root": {
      "description": "Absolute, normalised path: `/` or `/a/b` (no trailing `/`).",
      "type": "string"
    },
    "scheme": {
      "description": "OpenDAL service (`s3`, `gcs`, `azblob`, `fs`, `memory`, …) or `lab`.",
      "type": "string"
    }
  },
  "required": [
    "scheme",
    "authority",
    "root"
  ],
  "title": "oprobe target-id",
  "type": "object",
  "x-rust-type": "TargetId"
}
