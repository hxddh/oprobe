{
  "$defs": {
    "Access": {
      "description": "Key popularity: `uniform`, `zipf:S` (e.g. `zipf:1.1`) or `hotset:F/P` (e.g. `hotset:0.2/0.8`).",
      "type": "string"
    },
    "Addressing": {
      "description": "S3 bucket addressing.",
      "oneOf": [
        {
          "const": "auto",
          "description": "As the target configures it (OpenDAL's default: path style unless\n`enable_virtual_host_style`).",
          "type": "string"
        },
        {
          "const": "virtual",
          "description": "`https://bucket.s3.region.amazonaws.com/key`.",
          "type": "string"
        },
        {
          "const": "path",
          "description": "`https://s3.region.amazonaws.com/bucket/key`.",
          "type": "string"
        }
      ]
    },
    "Arrivals": {
      "description": "How open-loop arrivals are spaced.",
      "oneOf": [
        {
          "const": "constant",
          "description": "Evenly spaced: one arrival every `1 / rate` seconds.",
          "type": "string"
        },
        {
          "const": "poisson",
          "description": "A Poisson process: exponentially distributed gaps with mean `1 / rate` (bursty, like\nindependent clients).",
          "type": "string"
        }
      ]
    },
    "ByteSize": {
      "description": "A byte size: `4MiB`, `512KiB`, `1GB` (a plain number of bytes is accepted on input).",
      "type": "string"
    },
    "CostSpec": {
      "additionalProperties": false,
      "description": "Business volume used to project measured per-operation costs to a monthly bill.",
      "properties": {
        "egress_fraction": {
          "default": 0.0,
          "description": "Fraction of downloaded bytes that leave the cloud (internet egress).",
          "format": "double",
          "type": "number"
        },
        "monthly_ops": {
          "default": 100000000.0,
          "description": "Logical operations per month at this workload mix.",
          "format": "double",
          "type": "number"
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pricing"
            },
            {
              "type": "null"
            }
          ],
          "description": "Custom price overrides (USD)."
        },
        "provider": {
          "description": "Pricing preset: aws-s3, gcs, azure-blob, cloudflare-r2, backblaze-b2, aliyun-oss.\nDefaults to the target's provider.",
          "type": [
            "string",
            "null"
          ]
        },
        "stored_gib": {
          "default": 1024.0,
          "description": "Data kept at rest (GiB).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "monthly_ops",
        "stored_gib",
        "egress_fraction"
      ],
      "type": "object"
    },
    "DatasetSpec": {
      "additionalProperties": false,
      "description": "Objects the workload reads from.",
      "properties": {
        "existing_prefix": {
          "description": "Benchmark **existing** objects under this prefix (read-only; nothing is written).",
          "type": [
            "string",
            "null"
          ]
        },
        "object_size": {
          "$ref": "#/$defs/ByteSize",
          "default": "4MiB"
        },
        "objects": {
          "default": 16,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "partitions": {
          "default": 4,
          "description": "Spread objects across this many `part=NN/` prefixes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "persist": {
          "default": false,
          "description": "Keep the generated dataset between runs (`oprobe-dataset/<fingerprint>/`) to avoid\nre-uploading it every time. Remove with `oprobe cleanup --datasets`.",
          "type": "boolean"
        },
        "size_dist": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeDist"
            },
            {
              "type": "null"
            }
          ],
          "description": "Object sizes drawn from a distribution (`object_size` is then its median)."
        }
      },
      "required": [
        "objects",
        "object_size",
        "partitions",
        "persist"
      ],
      "type": "object"
    },
    "HttpVersion": {
      "description": "HTTP protocol preference.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Negotiate via ALPN (h2 preferred for https), HTTP/1.1 for plain http.",
          "type": "string"
        },
        {
          "const": "h1",
          "description": "Force HTTP/1.1.",
          "type": "string"
        },
        {
          "const": "h2",
          "description": "Require HTTP/2 (ALPN for https, prior knowledge for plain http).",
          "type": "string"
        }
      ]
    },
    "HumanDuration": {
      "description": "A duration: `10s`, `500ms`, `2m` (plain seconds are accepted on input).",
      "type": "string"
    },
    "Knobs": {
      "additionalProperties": false,
      "description": "Client-side configuration under test / being tuned.",
      "properties": {
        "cache": {
          "default": false,
          "description": "In-memory read cache.",
          "type": "boolean"
        },
        "cache_size": {
          "$ref": "#/$defs/ByteSize",
          "default": "256MiB"
        },
        "chunk_size": {
          "$ref": "#/$defs/ByteSize",
          "default": "8MiB",
          "description": "Reader/writer chunk size (`.chunk(n)`), also the multipart part size."
        },
        "concurrency": {
          "default": 16,
          "description": "Concurrent logical operations (closed-loop workers, or open-loop in-flight cap).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "http_version": {
          "$ref": "#/$defs/HttpVersion",
          "default": "auto"
        },
        "io_concurrency": {
          "default": 4,
          "description": "Per-operation reader/writer concurrency (`.concurrent(n)`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keep_alive": {
          "default": true,
          "type": "boolean"
        },
        "max_inflight_requests": {
          "default": 0,
          "description": "Cap on in-flight HTTP requests across the client (0 = unlimited).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKnobs",
          "description": "Provider request options (addressing style, checksums, SSE), applied when the session\nopens."
        },
        "range_gap": {
          "$ref": "#/$defs/ByteSize",
          "default": "64KiB",
          "description": "Merge vectored ranges closer than this (`.gap(n)`)."
        },
        "retries": {
          "default": 3,
          "description": "Retry attempts on temporary errors (OpenDAL `RetryLayer`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tail_cut": {
          "default": false,
          "description": "Cancel & retry straggler requests above the adaptive p95 deadline (`TailCutLayer`).",
          "type": "boolean"
        },
        "timeout": {
          "$ref": "#/$defs/HumanDuration",
          "default": "1m",
          "description": "Per-operation timeout."
        },
        "transport": {
          "$ref": "#/$defs/TransportMode",
          "default": "opendal",
          "description": "How requests are made and observed: `opendal` = OpenDAL's own reqwest client (what\nproduction runs; the default), `microscope` = oprobe's instrumented connection pool\n(exact queue / per-dial phases / HTTP/2 streams, but a different client)."
        }
      },
      "required": [
        "concurrency",
        "io_concurrency",
        "chunk_size",
        "range_gap",
        "max_inflight_requests",
        "http_version",
        "transport",
        "keep_alive",
        "cache",
        "cache_size",
        "retries",
        "tail_cut",
        "timeout"
      ],
      "type": "object"
    },
    "OpSpec": {
      "description": "One weighted operation in the workload mix.",
      "oneOf": [
        {
          "description": "Read a random range of `size` bytes, or the whole object when `size` is omitted.",
          "properties": {
            "op": {
              "const": "read",
              "type": "string"
            },
            "size": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ByteSize"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "description": "`stat` + footer read + `columns` random column chunks fetched as one vectored read.\nWith `suffix`, the footer is read with a suffix range (`bytes=-N`) and no `stat`: one\nrequest fewer per file.",
          "properties": {
            "column_size": {
              "$ref": "#/$defs/ByteSize"
            },
            "columns": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "footer_size": {
              "$ref": "#/$defs/ByteSize"
            },
            "op": {
              "const": "parquet_scan",
              "type": "string"
            },
            "suffix": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "columns",
            "column_size",
            "footer_size"
          ],
          "type": "object"
        },
        {
          "description": "Single PUT of `size` bytes.",
          "properties": {
            "op": {
              "const": "write",
              "type": "string"
            },
            "size": {
              "$ref": "#/$defs/ByteSize"
            }
          },
          "required": [
            "op",
            "size"
          ],
          "type": "object"
        },
        {
          "description": "Streaming multipart write of `size` bytes (chunked by `knobs.chunk_size`).",
          "properties": {
            "op": {
              "const": "multipart_write",
              "type": "string"
            },
            "size": {
              "$ref": "#/$defs/ByteSize"
            }
          },
          "required": [
            "op",
            "size"
          ],
          "type": "object"
        },
        {
          "description": "HEAD a dataset object.",
          "properties": {
            "op": {
              "const": "stat",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "description": "LIST one dataset partition.",
          "properties": {
            "op": {
              "const": "list",
              "type": "string"
            },
            "recursive": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "recursive"
          ],
          "type": "object"
        },
        {
          "description": "LIST one dataset partition `limit` keys per page (each page is a billed request).",
          "properties": {
            "limit": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "list_paged",
              "type": "string"
            }
          },
          "required": [
            "op",
            "limit"
          ],
          "type": "object"
        },
        {
          "description": "Delete up to `batch` objects the workload wrote, in one batch (OpenDAL `Deleter`:\n`DeleteObjects` where the service batches).",
          "properties": {
            "batch": {
              "default": 100,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "delete",
              "type": "string"
            }
          },
          "required": [
            "op",
            "batch"
          ],
          "type": "object"
        },
        {
          "description": "Server-side copy of a dataset object to a scratch key.",
          "properties": {
            "op": {
              "const": "copy",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "description": "GET a dataset object through a presigned URL.",
          "properties": {
            "op": {
              "const": "presigned_read",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "description": "Optimistic-concurrency write of `size` bytes: create with `If-None-Match: *`, then\noverwrite with `If-Match: <etag of the previous write>`.",
          "properties": {
            "op": {
              "const": "conditional_write",
              "type": "string"
            },
            "size": {
              "$ref": "#/$defs/ByteSize"
            }
          },
          "required": [
            "op",
            "size"
          ],
          "type": "object"
        },
        {
          "description": "Small write carrying `entries` user-metadata pairs and a content type.",
          "properties": {
            "entries": {
              "default": 4,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "metadata_write",
              "type": "string"
            },
            "size": {
              "$ref": "#/$defs/ByteSize"
            }
          },
          "required": [
            "op",
            "size",
            "entries"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "weight": {
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "weight"
      ],
      "type": "object"
    },
    "Preset": {
      "oneOf": [
        {
          "const": "parquet",
          "description": "Lakehouse scan: stat + footer read + vectored column-chunk range reads.",
          "type": "string"
        },
        {
          "const": "checkpoint",
          "description": "AI/ML checkpoint: large multipart writes plus occasional full restores.",
          "type": "string"
        },
        {
          "const": "small-files",
          "description": "Many small objects: whole-object GETs and PUTs.",
          "type": "string"
        },
        {
          "const": "metadata",
          "description": "Metadata-heavy: LIST and HEAD storms over a partitioned prefix.",
          "type": "string"
        },
        {
          "const": "mixed",
          "description": "General purpose 70/20/10 read/write/stat mix.",
          "type": "string"
        },
        {
          "const": "parquet-suffix",
          "description": "Lakehouse scan reading the footer with a suffix range (no HEAD per file).",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "Churn: small writes removed again by batched deletes (OpenDAL `Deleter`).",
          "type": "string"
        },
        {
          "const": "copy",
          "description": "Server-side copies of dataset objects.",
          "type": "string"
        },
        {
          "const": "list-paged",
          "description": "LIST with a page size (`limit`): every page is a billed request.",
          "type": "string"
        },
        {
          "const": "presign",
          "description": "GETs through presigned URLs.",
          "type": "string"
        },
        {
          "const": "conditional",
          "description": "Optimistic concurrency: conditional create (`If-None-Match: *`) and overwrite (`If-Match`).",
          "type": "string"
        },
        {
          "const": "metadata-heavy",
          "description": "HEAD storm plus small writes carrying user metadata.",
          "type": "string"
        }
      ]
    },
    "Pricing": {
      "additionalProperties": false,
      "description": "Provider list prices in USD (request prices per million, data per GB = 1e9 bytes).",
      "properties": {
        "delete_per_million": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "egress_per_gb": {
          "description": "Internet egress per GB.",
          "format": "double",
          "type": "number"
        },
        "list_per_million": {
          "format": "double",
          "type": "number"
        },
        "note": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "read_per_million": {
          "description": "GET / HEAD.",
          "format": "double",
          "type": "number"
        },
        "storage_gb_month": {
          "format": "double",
          "type": "number"
        },
        "write_per_million": {
          "description": "PUT / POST / COPY / multipart part & complete.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "storage_gb_month",
        "write_per_million",
        "list_per_million",
        "read_per_million",
        "delete_per_million",
        "egress_per_gb"
      ],
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "Complete, round-trippable benchmark profile.",
      "properties": {
        "cost": {
          "$ref": "#/$defs/CostSpec",
          "default": {
            "egress_fraction": 0.0,
            "monthly_ops": 100000000.0,
            "stored_gib": 1024.0
          }
        },
        "knobs": {
          "$ref": "#/$defs/Knobs",
          "default": {
            "cache": false,
            "cache_size": "256MiB",
            "chunk_size": "8MiB",
            "concurrency": 16,
            "http_version": "auto",
            "io_concurrency": 4,
            "keep_alive": true,
            "max_inflight_requests": 0,
            "range_gap": "64KiB",
            "retries": 3,
            "tail_cut": false,
            "timeout": "1m",
            "transport": "opendal"
          }
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sla": {
          "$ref": "#/$defs/Sla",
          "default": {
            "enforce": true,
            "max_error_rate": 0.01
          }
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadSpec",
          "default": {
            "access": "uniform",
            "cleanup": true,
            "duration": "10s",
            "preset": "parquet",
            "seed": 42,
            "verify": true,
            "warmup": "2s"
          }
        }
      },
      "required": [
        "target",
        "workload",
        "knobs",
        "sla",
        "cost"
      ],
      "type": "object"
    },
    "ProviderKnobs": {
      "additionalProperties": false,
      "description": "Provider request options measured for their overhead (S3 service options).",
      "properties": {
        "addressing": {
          "$ref": "#/$defs/Addressing",
          "default": "auto"
        },
        "checksum": {
          "description": "Checksum the client computes and the server verifies on writes (`crc32c`).",
          "type": [
            "string",
            "null"
          ]
        },
        "sse": {
          "description": "Server-side encryption: `AES256` or `aws:kms`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "addressing"
      ],
      "type": "object"
    },
    "RateShape": {
      "description": "Time-varying open-loop rate: ramp:FROM..TO/DURATION, step:R1,R2,…/DURATION or diurnal[:MIN..MAX/PERIOD]",
      "type": "string"
    },
    "ReplaySpec": {
      "additionalProperties": false,
      "description": "What to replay (`workload.replay`).",
      "properties": {
        "file": {
          "description": "The log: an S3 server access log, CloudTrail JSON (S3 data events) or an oprobe run file.",
          "type": "string"
        },
        "map_prefix": {
          "description": "Key rewrites, the first matching prefix wins (`$RUN/` targets the run prefix).",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "speed": {
          "default": 1.0,
          "description": "Speed factor: 2 replays twice as fast as recorded.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "file",
        "speed"
      ],
      "type": "object"
    },
    "SizeDist": {
      "description": "Object size distribution: dist:lognormal(MEDIAN,SIGMA) or file:PATH",
      "type": "string"
    },
    "Sla": {
      "additionalProperties": false,
      "description": "Service level objectives. `oprobe run` / `oprobe tune` exit with code 3 when the measured\nresult breaches them (unless `enforce = false` / `--sla none`); the tuner rejects trials that\nbreach them and the diagnosis grades findings against them.",
      "properties": {
        "enforce": {
          "default": true,
          "description": "Turn a breach into exit code 3. Corrupted data (CRC mismatch) is always a breach.",
          "type": "boolean"
        },
        "max_error_rate": {
          "default": 0.01,
          "description": "Max fraction of failed operations (default 0.01 = 1%).",
          "format": "double",
          "type": "number"
        },
        "max_throttle_rate": {
          "description": "Max fraction of operations that hit a 429/503 throttle. Unset: throttling that retries\nabsorb does not breach the SLA of a run (it is still a finding), and the tuner treats\nany throttling as infeasible.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p99_ms": {
          "description": "Max acceptable p99 per operation verb (ms); unset = no latency constraint.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "enforce",
        "max_error_rate"
      ],
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "description": "Storage target. Either `url = \"s3://bucket/prefix\"` or explicit `scheme` + `options`.",
      "properties": {
        "ca_cert": {
          "description": "Extra PEM CA bundle to trust.",
          "type": [
            "string",
            "null"
          ]
        },
        "insecure": {
          "description": "Skip TLS certificate verification (self-signed dev endpoints only).",
          "type": "boolean"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "OpenDAL service options. Values may reference environment variables as `${NAME}`.",
          "type": "object"
        },
        "proxy": {
          "description": "Egress proxy URL; `\"none\"` disables proxies; unset = `HTTPS_PROXY`/`HTTP_PROXY` env.",
          "type": [
            "string",
            "null"
          ]
        },
        "scheme": {
          "description": "OpenDAL scheme; derived from `url` when empty (and then not written back).",
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "options"
      ],
      "type": "object"
    },
    "TransportMode": {
      "oneOf": [
        {
          "const": "opendal",
          "description": "OpenDAL's default HTTP client (reqwest), observed through its extension points.",
          "type": "string"
        },
        {
          "const": "microscope",
          "description": "oprobe's own instrumented connection pool.",
          "type": "string"
        }
      ]
    },
    "WorkloadSpec": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/Access",
          "default": "uniform"
        },
        "arrivals": {
          "$ref": "#/$defs/Arrivals",
          "description": "Open-loop arrival process: `constant` (evenly spaced) or `poisson` (design v5 §3)."
        },
        "cleanup": {
          "default": true,
          "description": "Delete everything written under the run prefix when the run ends.",
          "type": "boolean"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset override (defaults come from the preset)."
        },
        "duration": {
          "$ref": "#/$defs/HumanDuration",
          "default": "10s"
        },
        "max_ops": {
          "description": "Stop after this many measured operations (deterministic CI runs).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mix": {
          "description": "Operation mix override (defaults come from the preset).",
          "items": {
            "$ref": "#/$defs/OpSpec"
          },
          "type": "array"
        },
        "preset": {
          "$ref": "#/$defs/Preset",
          "default": "parquet"
        },
        "rate": {
          "description": "Open-loop arrival rate in ops/s. Unset = closed loop (`knobs.concurrency` workers).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "replay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplaySpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replay a traffic log instead of the mix (open loop on the log's timing)."
        },
        "seed": {
          "default": 42,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateShape"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time-varying open-loop rate: `ramp:FROM..TO/D`, `step:R1,R2,…/D` or\n`diurnal[:MIN..MAX/PERIOD]` (makes the run open-loop; `rate` is then the diurnal peak)."
        },
        "verify": {
          "default": true,
          "description": "Verify CRC32C of whole-object reads and sampled writes.",
          "type": "boolean"
        },
        "warmup": {
          "$ref": "#/$defs/HumanDuration",
          "default": "2s"
        }
      },
      "required": [
        "preset",
        "duration",
        "warmup",
        "access",
        "verify",
        "cleanup",
        "seed"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/run-spec.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The replayable definition of a run (report.spec; `oprobe run --from RUN`)",
  "properties": {
    "existing": {
      "description": "`--existing PREFIX`: benchmark existing objects (read-only).",
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "$ref": "#/$defs/Profile",
      "description": "The fully resolved profile (preset defaults are kept implicit, as in a profile file).\nSecret options are `\"<redacted>\"` (environment references such as\n`${AWS_SECRET_ACCESS_KEY}` are kept: they are not secrets); options the target URL\nimplies are left out, so the profile's target holds only what was added on top."
    },
    "seed": {
      "description": "The dataset / key-choice seed the run used.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "target_ref": {
      "description": "The target as given: a configured target name, a storage URL or `lab://SCENARIO`.",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "target_ref",
    "seed"
  ],
  "title": "oprobe run-spec",
  "type": "object",
  "x-rust-type": "RunSpec"
}
