{
  "$defs": {
    "Budgets": {
      "description": "Limits for one command.",
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_cost_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/compat-plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe compat --dry-run`",
  "properties": {
    "budgets": {
      "$ref": "#/$defs/Budgets"
    },
    "estimated_bytes": {
      "description": "Upper bound of the bytes uploaded (multipart checks write 3 parts of the minimum size).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "estimated_cost_usd": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "estimated_requests_count": {
      "description": "Upper bound of the requests the suite sends.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "run_prefix": {
      "description": "Prefix the suite writes under (`oprobe-run-<id>/`; `oprobe cleanup` sweeps it).",
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "target",
    "run_prefix",
    "estimated_requests_count",
    "estimated_bytes",
    "budgets",
    "next",
    "warnings"
  ],
  "title": "oprobe compat-plan",
  "type": "object",
  "x-rust-type": "CompatPlan"
}
