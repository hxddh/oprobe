{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/worker.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `oprobe worker` serves (design v5 §8)",
  "properties": {
    "clients": {
      "description": "Clients coordinators may use here (`exec` only with `--allow-exec`).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "listening": {
      "description": "The bound `host:port` (with `--listen …:0`, the port chosen).",
      "type": "string"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "protocol": {
      "description": "`oprobe.worker/1`.",
      "type": "string"
    },
    "tls": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "listening",
    "protocol",
    "version",
    "tls",
    "clients",
    "next",
    "warnings"
  ],
  "title": "oprobe worker",
  "type": "object",
  "x-rust-type": "WorkerOutput"
}
