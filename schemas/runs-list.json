{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "RunSummary": {
      "description": "Sidecar summary of a run (`runs/<id>.json`).",
      "properties": {
        "cost_per_month_usd": {
          "description": "Projected monthly cost, where cost applies.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "error_ratio": {
          "format": "double",
          "type": "number"
        },
        "headline": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "interrupted": {
          "type": "boolean"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "ops_per_s": {
          "format": "double",
          "type": "number"
        },
        "p50_ms": {
          "format": "double",
          "type": "number"
        },
        "p99_ms": {
          "format": "double",
          "type": "number"
        },
        "path": {
          "description": "The run file (filled in when listing; not stored).",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "target_display": {
          "type": "string"
        },
        "target_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict_level": {
          "$ref": "#/$defs/VerdictLevel"
        },
        "window_s": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "target_display",
        "started_at",
        "window_s",
        "interrupted",
        "verdict_level",
        "headline",
        "ops_per_s",
        "p50_ms",
        "p99_ms",
        "error_ratio"
      ],
      "type": "object"
    },
    "VerdictLevel": {
      "description": "Overall judgement.",
      "oneOf": [
        {
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "const": "review",
          "description": "Worth a look (informational findings, warnings, partial run).",
          "type": "string"
        },
        {
          "const": "attention",
          "description": "Warning findings.",
          "type": "string"
        },
        {
          "const": "critical",
          "description": "Critical findings or a breached SLA.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/runs-list.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe runs list`",
  "properties": {
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "type": "array"
    },
    "total_count": {
      "description": "Runs stored in total (the list may be limited).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "runs",
    "total_count",
    "next",
    "warnings"
  ],
  "title": "oprobe runs-list",
  "type": "object",
  "x-rust-type": "RunsList"
}
