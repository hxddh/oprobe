{
  "$defs": {
    "NextStep": {
      "description": "A suggested next step: what it does and the CLI command.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/9/lab.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The startup document of `oprobe lab -o json`: endpoint, scenario and active faults",
  "properties": {
    "endpoint": {
      "type": "string"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "tls": {
      "type": "boolean"
    },
    "try_command": {
      "description": "A command that benchmarks the lab.",
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "endpoint",
    "tls",
    "try_command",
    "next",
    "warnings"
  ],
  "title": "oprobe lab",
  "type": "object",
  "x-rust-type": "LabOutput"
}
