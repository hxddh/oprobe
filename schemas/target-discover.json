{
  "$defs": {
    "Cloud": {
      "description": "Which cloud a credential source is for.",
      "enum": [
        "aws",
        "gcp",
        "azure"
      ],
      "type": "string"
    },
    "CredentialSource": {
      "description": "One credential source, by name only.",
      "properties": {
        "add_command": {
          "description": "`oprobe target add` for a bucket of this source (replace BUCKET).",
          "type": "string"
        },
        "cloud": {
          "$ref": "#/$defs/Cloud"
        },
        "endpoint": {
          "description": "The endpoint configured with it (S3-compatible services), when one is.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`aws_profile`, `aws_environment`, `aws_web_identity`, `gcp_adc`, `gcp_environment`,\n`azure_environment`.",
          "type": "string"
        },
        "name": {
          "description": "The profile, account or variable set it is known by (never a secret).",
          "type": "string"
        },
        "region": {
          "description": "The region configured with it, when one is.",
          "type": [
            "string",
            "null"
          ]
        },
        "scheme": {
          "description": "The URL scheme it serves (`s3`, `gcs`, `azblob`).",
          "type": "string"
        },
        "source": {
          "description": "Where it was found: a file path or environment variable names.",
          "type": "string"
        }
      },
      "required": [
        "cloud",
        "kind",
        "name",
        "source",
        "scheme",
        "add_command"
      ],
      "type": "object"
    },
    "KnownTarget": {
      "description": "A configured target.",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/target-discover.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe target discover` (MCP discover_targets): credential sources by name",
  "properties": {
    "config_file": {
      "description": "The config file the targets come from.",
      "type": "string"
    },
    "default_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "sources": {
      "description": "Credential sources found, AWS profiles first (`default` first).",
      "items": {
        "$ref": "#/$defs/CredentialSource"
      },
      "type": "array"
    },
    "targets": {
      "description": "Targets already in the config file.",
      "items": {
        "$ref": "#/$defs/KnownTarget"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "sources",
    "targets",
    "config_file",
    "next",
    "warnings"
  ],
  "title": "oprobe target-discover",
  "type": "object",
  "x-rust-type": "Discovery"
}
