{
  "$defs": {
    "CompatCheck": {
      "description": "One compatibility check.",
      "properties": {
        "category": {
          "description": "`consistency`, `conditional`, `multipart`, `range`, `integrity`, `metadata`, `delete`,\n`list`, `copy`, `versioning`, `http`.",
          "type": "string"
        },
        "detail": {
          "description": "What happened (the observed behavior, or why the check was skipped).",
          "type": "string"
        },
        "duration_ms": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "description": "Stable identifier, e.g. `conditional_create`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CompatStatus"
        }
      },
      "required": [
        "id",
        "category",
        "status",
        "detail",
        "duration_ms"
      ],
      "type": "object"
    },
    "CompatStatus": {
      "description": "Outcome of one check.",
      "enum": [
        "pass",
        "fail",
        "skipped"
      ],
      "type": "string"
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/compat.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe compat`",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/CompatCheck"
      },
      "type": "array"
    },
    "cleaned_up": {
      "description": "The prefix was deleted and verified empty.",
      "type": "boolean"
    },
    "failed_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "min_score_pct": {
      "description": "`--min-score` (percent), when given.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "passed_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "prefix": {
      "description": "Object prefix the suite wrote under (deleted afterwards).",
      "type": "string"
    },
    "scheme": {
      "type": "string"
    },
    "score_pct": {
      "description": "passed / (passed + failed), percent.",
      "format": "double",
      "type": "number"
    },
    "skipped_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "target": {
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "target",
    "scheme",
    "prefix",
    "checks",
    "passed_count",
    "failed_count",
    "skipped_count",
    "score_pct",
    "cleaned_up",
    "next",
    "warnings"
  ],
  "title": "oprobe compat",
  "type": "object",
  "x-rust-type": "CompatOutput"
}
