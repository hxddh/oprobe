{
  "$defs": {
    "BudgetDefaults": {
      "additionalProperties": false,
      "description": "`[defaults.budgets]`: the `--max-*` safety flags' defaults.",
      "properties": {
        "max_bytes": {
          "description": "Bytes transferred, e.g. `10GiB`.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_cost_usd": {
          "description": "Estimated request cost (USD).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_duration": {
          "description": "Wall time, e.g. `5m`.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_requests": {
          "description": "Backend requests.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "Settings applied to every command unless overridden.",
      "properties": {
        "budgets": {
          "$ref": "#/$defs/BudgetDefaults",
          "description": "Budgets of every measuring command (`run`, `tune`, `matrix`, `watch`, `compat`, the\napp) unless a flag sets them (`[defaults.budgets]`)."
        },
        "color": {
          "description": "`auto`, `always`, `never`.",
          "type": [
            "string",
            "null"
          ]
        },
        "concurrency": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "duration": {
          "description": "e.g. `30s`.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_requests": {
          "description": "Trace rows kept per run (`trace.max_requests`, default 1 000 000).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "description": "`text`, `json`, `ndjson`, `md`, `html`.",
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "Target used when a command is given none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TargetEntry": {
      "additionalProperties": false,
      "description": "A named storage endpoint.",
      "properties": {
        "credentials": {
          "description": "`env`, `profile:NAME` or `anonymous` (default: the provider's credential chain).",
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "OpenDAL options, validated against the service when the target is used.",
          "type": "object"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Storage URL, e.g. `s3://bucket/prefix`.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The config file (config.toml): [defaults] and [targets.NAME]",
  "properties": {
    "defaults": {
      "$ref": "#/$defs/Defaults",
      "default": {}
    },
    "targets": {
      "additionalProperties": {
        "$ref": "#/$defs/TargetEntry"
      },
      "type": "object"
    }
  },
  "title": "oprobe config",
  "type": "object",
  "x-rust-type": "ConfigFile"
}
