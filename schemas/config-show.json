{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "Setting": {
      "description": "One effective setting.",
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "source"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where an effective value comes from.",
      "enum": [
        "flag",
        "env",
        "target",
        "defaults",
        "builtin"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/config-show.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe config show`",
  "properties": {
    "config_file": {
      "type": "string"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "settings": {
      "items": {
        "$ref": "#/$defs/Setting"
      },
      "type": "array"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "config_file",
    "settings",
    "targets",
    "next",
    "warnings"
  ],
  "title": "oprobe config-show",
  "type": "object",
  "x-rust-type": "ConfigShow"
}
