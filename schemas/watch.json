{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "Rolling": {
      "description": "Metrics of the rolling window.",
      "properties": {
        "availability_ratio": {
          "format": "double",
          "type": "number"
        },
        "error_ratio": {
          "format": "double",
          "type": "number"
        },
        "ops_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p50_ms": {
          "format": "double",
          "type": "number"
        },
        "p90_ms": {
          "format": "double",
          "type": "number"
        },
        "p99_ms": {
          "format": "double",
          "type": "number"
        },
        "throttled_request_ratio": {
          "format": "double",
          "type": "number"
        },
        "windows_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "windows_count",
        "ops_count",
        "p50_ms",
        "p90_ms",
        "p99_ms",
        "error_ratio",
        "throttled_request_ratio",
        "availability_ratio"
      ],
      "type": "object"
    },
    "Slo": {
      "description": "A service level objective over the rolling window.",
      "properties": {
        "below": {
          "description": "The value must stay below (`true`) or above (`false`) the limit.",
          "type": "boolean"
        },
        "limit": {
          "description": "In `unit`.",
          "format": "double",
          "type": "number"
        },
        "metric": {
          "description": "`p50_ms`, `p90_ms`, `p99_ms`, `error_ratio`, `throttled_request_ratio`, `availability_ratio`.",
          "type": "string"
        },
        "spec": {
          "description": "As given, e.g. `p99<200ms`.",
          "type": "string"
        },
        "unit": {
          "description": "Unit of `limit` and of the measured values: `ms` or `ratio`.",
          "type": "string"
        }
      },
      "required": [
        "spec",
        "metric",
        "below",
        "limit",
        "unit"
      ],
      "type": "object"
    },
    "SloState": {
      "properties": {
        "breached_windows_count": {
          "description": "Probe windows that ended with the SLO breached.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "slo": {
          "$ref": "#/$defs/Slo"
        },
        "unit": {
          "description": "`ms` or `ratio`.",
          "type": "string"
        },
        "value": {
          "description": "In `unit`.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "slo",
        "ok",
        "value",
        "unit",
        "breached_windows_count"
      ],
      "type": "object"
    },
    "Transition": {
      "description": "An SLO changing state.",
      "properties": {
        "at": {
          "description": "RFC 3339.",
          "type": "string"
        },
        "slo": {
          "type": "string"
        },
        "state": {
          "description": "`breached` or `recovered`.",
          "type": "string"
        },
        "unit": {
          "description": "`ms` or `ratio`.",
          "type": "string"
        },
        "value": {
          "description": "In `unit`.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "at",
        "slo",
        "state",
        "value",
        "unit"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/watch.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe watch`",
  "properties": {
    "listen": {
      "type": [
        "string",
        "null"
      ]
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "rolling": {
      "$ref": "#/$defs/Rolling"
    },
    "slos": {
      "items": {
        "$ref": "#/$defs/SloState"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "windows_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "target",
    "windows_count",
    "rolling",
    "slos",
    "transitions",
    "next",
    "warnings"
  ],
  "title": "oprobe watch",
  "type": "object",
  "x-rust-type": "WatchOutput"
}
