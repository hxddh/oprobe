{
  "$defs": {
    "Direction": {
      "description": "Which way a metric should move.",
      "oneOf": [
        {
          "const": "increase",
          "description": "Higher than the baseline.",
          "type": "string"
        },
        {
          "const": "decrease",
          "description": "Lower than the baseline.",
          "type": "string"
        },
        {
          "const": "at_most",
          "description": "At most the predicted value (e.g. a throttle budget).",
          "type": "string"
        },
        {
          "const": "at_least",
          "description": "At least the predicted value.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "Within the interval of the baseline (a change that must not cost anything).",
          "type": "string"
        }
      ]
    },
    "Expectation": {
      "description": "What a change should do to one metric: a predicted value with an interval.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "hi": {
          "description": "Upper end of the prediction interval, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "lo": {
          "description": "Lower end of the prediction interval, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "metric": {
          "description": "A report metric path, e.g. `summary.ops_per_s`, `throttled_request_ratio`, `p99_ms`.",
          "type": "string"
        },
        "predicted": {
          "description": "Predicted value, in `unit`.",
          "format": "double",
          "type": "number"
        },
        "unit": {
          "description": "Unit of `predicted`, `lo` and `hi` (`ops_per_s`, `ms`, `ratio`, …).",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "direction",
        "predicted",
        "lo",
        "hi",
        "unit"
      ],
      "type": "object"
    },
    "Overrides": {
      "description": "A change to a run: `--set key=value` pairs grouped by the part of the profile they change\n(canonical key names, see [`SET_KEYS`]). Built with [`Overrides::set`], which validates.",
      "properties": {
        "cost": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "knobs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "sla": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "target": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "workload": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/verification.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "How to test a finding's advice: overrides, commands and expectations",
  "properties": {
    "command": {
      "description": "`oprobe verify RUN CODE`: replays the run with and without the change and judges it.",
      "type": "string"
    },
    "description": {
      "description": "The hypothesis in words.",
      "type": "string"
    },
    "expect": {
      "description": "What the change should do (filled by the findings that can predict it).",
      "items": {
        "$ref": "#/$defs/Expectation"
      },
      "type": "array"
    },
    "overrides": {
      "$ref": "#/$defs/Overrides",
      "description": "The change to the run's spec."
    },
    "replay": {
      "description": "The changed run as a self-contained `oprobe run TARGET …` command (no stored run\nneeded).",
      "type": "string"
    },
    "rerun": {
      "description": "`oprobe run --from RUN --set …`: the changed run alone.",
      "type": "string"
    }
  },
  "required": [
    "description",
    "overrides",
    "command",
    "rerun",
    "replay"
  ],
  "title": "oprobe verification",
  "type": "object",
  "x-rust-type": "Verification"
}
