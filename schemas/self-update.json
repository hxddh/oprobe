{
  "$defs": {
    "InstallMethod": {
      "description": "How this binary was installed.",
      "oneOf": [
        {
          "enum": [
            "homebrew",
            "scoop",
            "winget",
            "cargo"
          ],
          "type": "string"
        },
        {
          "const": "standalone",
          "description": "A binary we may replace (install.sh / install.ps1, an extracted archive).",
          "type": "string"
        },
        {
          "const": "system_package",
          "description": "Debian/RPM package (`/usr/bin`).",
          "type": "string"
        },
        {
          "const": "macos_pkg",
          "description": "The macOS installer package (`/usr/local/bin` with a pkgutil receipt).",
          "type": "string"
        },
        {
          "const": "macos_app",
          "description": "Inside `oprobe.app` (the disk image).",
          "type": "string"
        },
        {
          "const": "msi",
          "description": "The Windows installer (Program Files).",
          "type": "string"
        }
      ]
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "ReleaseSource": {
      "description": "Where `self-update` found the release.",
      "oneOf": [
        {
          "const": "latest_json",
          "description": "The release's `latest.json` index.",
          "type": "string"
        },
        {
          "const": "api",
          "description": "The GitHub REST API.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/self-update.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe self-update`",
  "properties": {
    "asset": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_version": {
      "type": "string"
    },
    "executable": {
      "type": "string"
    },
    "install_method": {
      "$ref": "#/$defs/InstallMethod"
    },
    "installed": {
      "description": "The new version was installed.",
      "type": "boolean"
    },
    "latest_version": {
      "type": "string"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "release_source": {
      "$ref": "#/$defs/ReleaseSource",
      "description": "Where the release was found."
    },
    "release_url": {
      "type": "string"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "update_available": {
      "type": "boolean"
    },
    "update_command": {
      "description": "How to update this install.",
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "current_version",
    "latest_version",
    "update_available",
    "installed",
    "install_method",
    "update_command",
    "executable",
    "release_url",
    "release_source",
    "next",
    "warnings"
  ],
  "title": "oprobe self-update",
  "type": "object",
  "x-rust-type": "UpdateOutput"
}
