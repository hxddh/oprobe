{
  "$defs": {
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/runs-export.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe runs export`",
  "properties": {
    "bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "description": "Files written (OTLP `--signal all`: one document per signal).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "format": {
      "type": "string"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "ops_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "requests_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "format",
    "bytes",
    "ops_count",
    "requests_count",
    "next",
    "warnings"
  ],
  "title": "oprobe runs-export",
  "type": "object",
  "x-rust-type": "ExportOutput"
}
