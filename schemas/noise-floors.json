{
  "$defs": {
    "NoiseEntry": {
      "description": "What repeated identical runs of one target and workload showed.",
      "properties": {
        "pair_deltas_ratio": {
          "additionalProperties": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "default": {},
          "description": "|b / a − 1| of each A/A pair, per metric (newest last, at most\n[`NOISE_SAMPLES_MAX`]).",
          "type": "object"
        },
        "pairs_count": {
          "default": 0,
          "description": "A/A pairs seen (calibrate and verify).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "updated_at": {
          "default": "",
          "description": "RFC 3339.",
          "type": "string"
        }
      },
      "required": [
        "pair_deltas_ratio",
        "pairs_count",
        "updated_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/4/noise-floors.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Noise floors learned per target and workload (<data>/noise.toml)",
  "properties": {
    "targets": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/NoiseEntry"
        },
        "type": "object"
      },
      "default": {},
      "type": "object"
    }
  },
  "required": [
    "targets"
  ],
  "title": "oprobe noise-floors",
  "type": "object",
  "x-rust-type": "NoiseFloors"
}
