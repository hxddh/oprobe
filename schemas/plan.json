{
  "$defs": {
    "Budgets": {
      "description": "Limits for one command.",
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does and the CLI command.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "Plan": {
      "description": "What a run would do (`--dry-run`).",
      "properties": {
        "assumptions": {
          "description": "How the estimates were made.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "command": {
          "default": "",
          "description": "The command that runs this plan (`oprobe run …`, every non-default setting).",
          "type": "string"
        },
        "concurrency_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "duration_s": {
          "format": "double",
          "type": "number"
        },
        "estimated_bytes": {
          "description": "Estimated bytes transferred (up + down).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "estimated_ops_count": {
          "description": "Estimated logical operations (warmup + window).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "estimated_requests_count": {
          "description": "Estimated backend requests (dataset upload + workload + cleanup).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eta_s": {
          "description": "Estimated wall time, dataset upload and cleanup included.",
          "format": "double",
          "type": "number"
        },
        "objects_deleted_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objects_written_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "preset": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "run_prefix": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_ref": {
          "default": "",
          "description": "The target as given (URL or `lab://` scenario), for the run command.",
          "type": "string"
        },
        "warmup_s": {
          "format": "double",
          "type": "number"
        },
        "warnings": {
          "default": [],
          "description": "Things that would run, but probably not as meant (e.g. warmup ≥ window).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "target",
        "preset",
        "run_prefix",
        "read_only",
        "concurrency_count",
        "warmup_s",
        "duration_s",
        "estimated_ops_count",
        "estimated_requests_count",
        "estimated_bytes",
        "objects_written_count",
        "objects_deleted_count",
        "eta_s",
        "budgets",
        "assumptions",
        "target_ref",
        "command",
        "warnings"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/9/plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result of `oprobe run --dry-run -o json`: the plan of every operator, nothing sent",
  "properties": {
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/Plan"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "plans",
    "next",
    "warnings"
  ],
  "title": "oprobe plan",
  "type": "object",
  "x-rust-type": "RunPlan"
}
