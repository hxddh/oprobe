{
  "$defs": {
    "MatrixCell": {
      "description": "One cell of the matrix.",
      "properties": {
        "cost_per_month_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "description": "The cell failed to run (error message); its numbers are zero.",
          "type": [
            "string",
            "null"
          ]
        },
        "error_ratio": {
          "format": "double",
          "type": "number"
        },
        "mib_per_s": {
          "format": "double",
          "type": "number"
        },
        "ops_per_s": {
          "format": "double",
          "type": "number"
        },
        "p50_ms": {
          "format": "double",
          "type": "number"
        },
        "p99_ms": {
          "format": "double",
          "type": "number"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Knob values of this cell (`--vary`).",
          "type": "object"
        },
        "target": {
          "type": "string"
        },
        "throttled_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verdict": {
          "type": "string"
        }
      },
      "required": [
        "rank",
        "target",
        "settings",
        "run_id",
        "ops_per_s",
        "mib_per_s",
        "p50_ms",
        "p99_ms",
        "error_ratio",
        "throttled_count",
        "verdict"
      ],
      "type": "object"
    },
    "McpCall": {
      "description": "An MCP tool call: the tool and its arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does, the CLI command, and the MCP call doing the same.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same step as an MCP tool call, when a tool does it."
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/5/matrix.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `oprobe matrix`",
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/MatrixCell"
      },
      "type": "array"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "rank_by": {
      "type": "string"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "rank_by",
    "cells",
    "next",
    "warnings"
  ],
  "title": "oprobe matrix",
  "type": "object",
  "x-rust-type": "MatrixOutput"
}
