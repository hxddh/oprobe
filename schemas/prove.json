{
  "$defs": {
    "ByteSize": {
      "description": "A byte size: `4MiB`, `512KiB`, `1GB` (a plain number of bytes is accepted on input).",
      "type": "string"
    },
    "Cache": {
      "additionalProperties": false,
      "description": "`FoyerLayer` over an in-memory foyer cache of `memory` bytes of data: any object no larger\nthan `memory` is cached whole, a larger one is read through.",
      "properties": {
        "memory": {
          "$ref": "#/$defs/ByteSize",
          "default": "256MiB"
        }
      },
      "required": [
        "memory"
      ],
      "type": "object"
    },
    "Change": {
      "description": "One changed value (`path` in `--set` form; values in TOML form, absent when unset).",
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "path": {
          "type": "string"
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "ChangeKind": {
      "description": "How one part of the operator changed.",
      "enum": [
        "added",
        "changed",
        "removed"
      ],
      "type": "string"
    },
    "ConcurrentLimit": {
      "additionalProperties": false,
      "description": "`ConcurrentLimitLayer`.",
      "properties": {
        "http": {
          "description": "HTTP requests in flight (`with_http_concurrent_limit`).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "operations": {
          "description": "Operations in flight (`ConcurrentLimitLayer::new`; unset: unlimited).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HttpOptions": {
      "additionalProperties": false,
      "description": "The HTTP client (OpenDAL's reqwest `HttpFetch`).",
      "properties": {
        "ca_cert": {
          "description": "An extra PEM CA bundle to trust.",
          "type": [
            "string",
            "null"
          ]
        },
        "insecure": {
          "description": "Skip TLS certificate verification (self-signed development endpoints only).",
          "type": "boolean"
        },
        "keep_alive": {
          "default": true,
          "description": "Reuse connections.",
          "type": "boolean"
        },
        "proxy": {
          "description": "Egress proxy URL; `none` ignores HTTPS_PROXY/HTTP_PROXY (unset: the environment).",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "$ref": "#/$defs/HttpVersion",
          "default": "auto",
          "description": "`auto` (OpenDAL's default: HTTP/1.1), `h1` or `h2`."
        }
      },
      "required": [
        "version",
        "keep_alive"
      ],
      "type": "object"
    },
    "HttpVersion": {
      "description": "HTTP protocol preference.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Negotiate via ALPN (h2 preferred for https), HTTP/1.1 for plain http.",
          "type": "string"
        },
        {
          "const": "h1",
          "description": "Force HTTP/1.1.",
          "type": "string"
        },
        {
          "const": "h2",
          "description": "Require HTTP/2 (ALPN for https, prior knowledge for plain http).",
          "type": "string"
        }
      ]
    },
    "HumanDuration": {
      "description": "A duration: `10s`, `500ms`, `2m` (plain seconds are accepted on input).",
      "type": "string"
    },
    "Interval": {
      "description": "An estimate with a confidence interval.",
      "properties": {
        "estimate": {
          "format": "double",
          "type": "number"
        },
        "high": {
          "format": "double",
          "type": "number"
        },
        "low": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "estimate",
        "low",
        "high"
      ],
      "type": "object"
    },
    "Layers": {
      "additionalProperties": false,
      "description": "The layer stack: each key is one OpenDAL layer.",
      "properties": {
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cache"
            },
            {
              "type": "null"
            }
          ],
          "description": "`FoyerLayer` with an in-memory cache (off by default)."
        },
        "concurrent_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConcurrentLimit"
            },
            {
              "type": "null"
            }
          ],
          "description": "`ConcurrentLimitLayer` (off by default)."
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "description": "`RetryLayer` (on by default)."
        },
        "tail_cut": {
          "anyOf": [
            {
              "$ref": "#/$defs/TailCut"
            },
            {
              "type": "null"
            }
          ],
          "description": "`TailCutLayer` (off by default)."
        },
        "throttle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Throttle"
            },
            {
              "type": "null"
            }
          ],
          "description": "`ThrottleLayer` (off by default)."
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timeout"
            },
            {
              "type": "null"
            }
          ],
          "description": "`TimeoutLayer` (on by default)."
        }
      },
      "type": "object"
    },
    "NextStep": {
      "description": "A suggested next step: what it does and the CLI command.",
      "properties": {
        "cli": {
          "description": "The command line (`oprobe …`).",
          "type": "string"
        },
        "title": {
          "description": "What the step does, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "cli"
      ],
      "type": "object"
    },
    "OperatorDiff": {
      "description": "The changes from operator `a` to operator `b`, with their Rust and TOML renderings.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "rust": {
          "description": "The changed layers and options as Rust (`+` added, `~` changed, `-` removed).",
          "type": "string"
        },
        "toml": {
          "description": "The changed parts of `b` as `op.toml` lines.",
          "type": "string"
        }
      },
      "required": [
        "changes",
        "rust",
        "toml"
      ],
      "type": "object"
    },
    "OperatorSpec": {
      "additionalProperties": false,
      "description": "One OpenDAL operator: service, layers, read/write options, HTTP client settings.",
      "properties": {
        "http": {
          "$ref": "#/$defs/HttpOptions",
          "description": "The `HttpFetch` client's settings."
        },
        "layers": {
          "$ref": "#/$defs/Layers",
          "description": "The layer stack."
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "OpenDAL service options (checked against the service). Values may reference\nenvironment variables as `${NAME}`.",
          "type": "object"
        },
        "read": {
          "$ref": "#/$defs/ReadOptions",
          "description": "`read_with(path)` / `reader_with(path)` options."
        },
        "url": {
          "description": "The service: any OpenDAL scheme oprobe is built with (`s3://bucket/prefix`,\n`gcs://bucket`, `fs:///tmp/x`, `memory://`), or `lab://SCENARIO` for the local lab.",
          "type": "string"
        },
        "write": {
          "$ref": "#/$defs/WriteOptions",
          "description": "`writer_with(path)` options."
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ProveObjective": {
      "description": "What prove judges a change on.",
      "oneOf": [
        {
          "const": "goodput",
          "description": "Successful operations per second.",
          "type": "string"
        },
        {
          "const": "p99",
          "description": "The p99 operation latency.",
          "type": "string"
        }
      ]
    },
    "ProveTrial": {
      "description": "One trial run of a prove (an event as it finishes, and a row of the result).",
      "properties": {
        "error_ratio": {
          "description": "Operations that failed for reasons other than throttling, per operation.",
          "format": "double",
          "type": "number"
        },
        "feasible": {
          "description": "Within `--max-throttle` and the error ratio a run allows (1 %).",
          "type": "boolean"
        },
        "goodput_ops_per_s": {
          "format": "double",
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/TrialKind"
        },
        "ops_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p99_ms": {
          "format": "double",
          "type": "number"
        },
        "pair": {
          "description": "The A/B pair (0-based) of a baseline or candidate trial.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requests_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "description": "The stored trial run (a child of the prove).",
          "type": "string"
        },
        "throttled_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "throttled_request_ratio": {
          "format": "double",
          "type": "number"
        },
        "value": {
          "description": "The sized value of a sizing trial (or the candidate's), as `--set` writes it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "run_id",
        "goodput_ops_per_s",
        "p99_ms",
        "ops_count",
        "requests_count",
        "throttled_count",
        "throttled_request_ratio",
        "error_ratio",
        "feasible"
      ],
      "type": "object"
    },
    "ProveVerdict": {
      "description": "The verdict on the objective.",
      "enum": [
        "improved",
        "worse",
        "inconclusive"
      ],
      "type": "string"
    },
    "ReadOptions": {
      "additionalProperties": false,
      "description": "`read_with` / `reader_with` options (unset: OpenDAL's default).",
      "properties": {
        "chunk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrent": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Retry": {
      "additionalProperties": false,
      "description": "`RetryLayer` (OpenDAL's defaults: 3 times, 1 s to 60 s, factor 2, no jitter).",
      "properties": {
        "factor": {
          "default": 2.0,
          "format": "float",
          "type": "number"
        },
        "jitter": {
          "default": false,
          "type": "boolean"
        },
        "max_delay": {
          "$ref": "#/$defs/HumanDuration",
          "default": "1m"
        },
        "max_times": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "min_delay": {
          "$ref": "#/$defs/HumanDuration",
          "default": "1s"
        }
      },
      "required": [
        "max_times",
        "jitter",
        "min_delay",
        "max_delay",
        "factor"
      ],
      "type": "object"
    },
    "SecondaryMetric": {
      "description": "A secondary metric: shown, never decisive.",
      "properties": {
        "baseline": {
          "description": "Mean over the baseline trials (in the metric's unit).",
          "format": "double",
          "type": "number"
        },
        "candidate": {
          "description": "Mean over the candidate trials.",
          "format": "double",
          "type": "number"
        },
        "change": {
          "$ref": "#/$defs/Interval",
          "description": "Relative change (log ratio) for positive metrics, absolute difference (Newcombe) for\nshares; always within range."
        },
        "metric": {
          "description": "`p99_ms`, `goodput_ops_per_s`, `throttled_request_ratio`, `error_ratio`.",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "baseline",
        "candidate",
        "change"
      ],
      "type": "object"
    },
    "Sizing": {
      "description": "The sizing step: the path, the values tried and the knee.",
      "properties": {
        "feasible": {
          "description": "Some value met `--max-throttle` (otherwise the least throttled one was chosen).",
          "type": "boolean"
        },
        "path": {
          "description": "The sized operator path.",
          "type": "string"
        },
        "start": {
          "description": "Where the search started and why.",
          "type": "string"
        },
        "unmeasured": {
          "description": "Why no trial ran (the value was taken from the evidence instead).",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "The chosen value (the knee), as `--set` writes it.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value",
        "start",
        "feasible"
      ],
      "type": "object"
    },
    "TailCut": {
      "additionalProperties": false,
      "description": "`TailCutLayer`: cancel (and, through `RetryLayer`, re-issue) a request slower than the\n`percentile` of the recent latencies × `safety_factor`, the deadline clamped to\n`[min_deadline, max_deadline]`.\n\nThe defaults are what oprobe measures with, not OpenDAL's (1.3, 200 samples, 500 ms, 30 s):\na shorter warm-up and floor so that short runs can see the layer work, and a ceiling at the\ntimeout that severs the same calls. Generated Rust spells out every value that differs from OpenDAL's default.",
      "properties": {
        "max_deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanDuration"
            },
            {
              "type": "null"
            }
          ],
          "description": "The longest deadline (unset: the shorter of `layers.timeout.op` and `layers.timeout.io`,\nthe timeouts that sever the calls this layer times; 60 s without the timeout layer)."
        },
        "min_deadline": {
          "$ref": "#/$defs/HumanDuration",
          "default": "50ms",
          "description": "The shortest deadline."
        },
        "min_samples": {
          "default": 32,
          "description": "Latencies recorded before the layer cuts anything.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "percentile": {
          "default": 95,
          "description": "The latency percentile the deadline follows (50..99).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "safety_factor": {
          "default": 1.5,
          "description": "The deadline = percentile × this factor (1..5).",
          "format": "double",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/HumanDuration",
          "default": "1m",
          "description": "The sliding window of latencies (at most 120 s)."
        }
      },
      "required": [
        "percentile",
        "safety_factor",
        "min_samples",
        "min_deadline",
        "window"
      ],
      "type": "object"
    },
    "Throttle": {
      "additionalProperties": false,
      "description": "`ThrottleLayer` (bytes per second, and the largest burst).",
      "properties": {
        "bandwidth": {
          "$ref": "#/$defs/ByteSize",
          "default": "100MiB"
        },
        "burst": {
          "$ref": "#/$defs/ByteSize",
          "default": "16MiB"
        }
      },
      "required": [
        "bandwidth",
        "burst"
      ],
      "type": "object"
    },
    "Timeout": {
      "additionalProperties": false,
      "description": "`TimeoutLayer` (OpenDAL's defaults: 60 s per operation, 10 s per I/O).",
      "properties": {
        "io": {
          "$ref": "#/$defs/HumanDuration",
          "default": "10s",
          "description": "`with_io_timeout`: one read or write call."
        },
        "op": {
          "$ref": "#/$defs/HumanDuration",
          "default": "1m",
          "description": "`with_timeout`: one operation."
        }
      },
      "required": [
        "op",
        "io"
      ],
      "type": "object"
    },
    "TrialKind": {
      "description": "What a trial was for.",
      "oneOf": [
        {
          "const": "sizing",
          "description": "A sizing trial of the bracket search (the change at `value`).",
          "type": "string"
        },
        {
          "const": "baseline",
          "description": "The current operator (A).",
          "type": "string"
        },
        {
          "const": "candidate",
          "description": "The changed operator (B).",
          "type": "string"
        }
      ]
    },
    "WriteOptions": {
      "additionalProperties": false,
      "description": "`writer_with` options (unset: OpenDAL's default).",
      "properties": {
        "chunk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrent": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/hxddh/oprobe/schemas/9/prove.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result of `oprobe prove -o json`: the verdict on the objective and the operator diff",
  "properties": {
    "budget_exceeded": {
      "description": "A budget (`--max-duration`, `--max-requests`, `--max-bytes`) stopped the\nprove before it could finish: the result reads what was measured (exit 4).",
      "type": "boolean"
    },
    "change": {
      "description": "The change, as `PATH=VALUE` pairs (the sized value included).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "diff": {
      "$ref": "#/$defs/OperatorDiff",
      "description": "The operator change as Rust and TOML."
    },
    "environment": {
      "description": "Where it was validated (design v6 D3): the scheme and target.",
      "type": "string"
    },
    "finding": {
      "description": "The finding whose remedy was proven (absent for `--with` alone).",
      "type": [
        "string",
        "null"
      ]
    },
    "max_throttle_ratio": {
      "format": "double",
      "type": "number"
    },
    "next": {
      "description": "Suggested next steps.",
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "type": "array"
    },
    "noise_floor_ratio": {
      "description": "The A/A noise floor: the per-pair spread of the objective's log ratio.",
      "format": "double",
      "type": "number"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "objective": {
      "$ref": "#/$defs/ProveObjective"
    },
    "objective_delta": {
      "$ref": "#/$defs/Interval",
      "description": "Relative change of the objective (candidate vs baseline) with its 95 % interval,\nsigned in the metric's own direction (goodput +: more; p99 −: faster)."
    },
    "operator": {
      "$ref": "#/$defs/OperatorSpec",
      "description": "The proven candidate operator (secrets redacted), so `.prove.json` stands on its own."
    },
    "operator_ref": {
      "description": "The run's operator as given.",
      "type": "string"
    },
    "pairs_count": {
      "description": "Interleaved A/B pairs that ran.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "prove_id": {
      "description": "This prove (its trials are runs with this `parent_id`).",
      "type": "string"
    },
    "run_command": {
      "description": "`oprobe run` of the run's workload on the proven operator: the next profile.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "description": "The run whose operator was changed.",
      "type": "string"
    },
    "saved_to": {
      "description": "Where the proven operator was written (`--save`, when `verdict == improved`).",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "description": "Always [`PROVE_SCHEMA`].",
      "type": "string"
    },
    "secondary": {
      "description": "The other metrics (shown, never decisive).",
      "items": {
        "$ref": "#/$defs/SecondaryMetric"
      },
      "type": "array"
    },
    "sizing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sizing"
        },
        {
          "type": "null"
        }
      ]
    },
    "trials": {
      "description": "Every trial: sizing, then the A/B pairs.",
      "items": {
        "$ref": "#/$defs/ProveTrial"
      },
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/ProveVerdict"
    },
    "warnings": {
      "description": "Warnings of the command (also printed on stderr in text mode).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "prove_id",
    "run_id",
    "operator_ref",
    "operator",
    "environment",
    "change",
    "objective",
    "verdict",
    "objective_delta",
    "noise_floor_ratio",
    "pairs_count",
    "max_throttle_ratio",
    "secondary",
    "trials",
    "diff",
    "next",
    "warnings"
  ],
  "title": "oprobe prove",
  "type": "object",
  "x-rust-type": "ProveOutput"
}
