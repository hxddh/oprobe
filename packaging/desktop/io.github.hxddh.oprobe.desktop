[Desktop Entry]
Type=Application
Name=oprobe
GenericName=Storage Microscope
Comment=See which layer makes object-storage I/O slow or expensive
Exec=oprobe gui %U
Icon=io.github.hxddh.oprobe
Terminal=false
Categories=Development;Network;Monitor;
Keywords=s3;storage;benchmark;opendal;latency;
MimeType=application/x-oprobe-run;x-scheme-handler/oprobe;
StartupWMClass=io.github.hxddh.oprobe
